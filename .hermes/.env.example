# Copy to .env (never committed) and fill in.

# Dashboard login (you make these up; required inside Docker)
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=pedro
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=change-me
HERMES_DASHBOARD_BASIC_AUTH_SECRET=paste-output-of-openssl-rand-hex-32

# Model provider: Anthropic
ANTHROPIC_API_KEY=

# Optional, for later (rodado-studio image generation, etc.)
OPENAI_API_KEY=

# Optional: dashboard port on the host (change if another harness uses 9119)
# HERMES_PORT=9119
